# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local design and browser verification scratch data
.impeccable/npm-cache/
.impeccable/browser-profile/
.impeccable/tmp/
.impeccable/build/original-hashes.json
.impeccable/build/public-content.json
.impeccable/review/test-results/
.impeccable/test-postgres/
.impeccable/build/*.log
.impeccable/build/public-documents.json
.impeccable/build/browser-fixture.sql
.impeccable/build/postgrest.conf
.impeccable/build/fixture-env.json

.impeccable/review/*.log
.impeccable/build/dependency-audit.json

.impeccable/build/browser-tsconfig.json
